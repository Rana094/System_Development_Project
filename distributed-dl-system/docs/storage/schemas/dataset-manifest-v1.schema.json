{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:distributed-dl:storage:dataset-manifest:1",
  "title": "Immutable dataset manifest v1; semantic checks required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "dataset_id",
    "version",
    "owner",
    "previous_manifest_sha256",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "dataset-manifest"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^ds_[0-9a-f]{32}$",
      "minLength": 35,
      "maxLength": 35
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9_.@-]"
      }
    },
    "previous_manifest_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "type",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "type": {
                "const": "file"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "type"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "type": {
                "const": "directory"
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "previous_manifest_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_manifest_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00-\\x1f\\x7f\\ud800-\\udfff])[^/]+(?:/[^/]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
