{
  "schema_version": 1,
  "name": "binary-classification",
  "project": "classification_project",
  "entrypoint": [
    "python",
    "train.py",
    "--task",
    "binary",
    "--steps",
    "800",
    "--batch-delay",
    "0.08"
  ],
  "dataset": "binary-classification.csv",
  "execution": {
    "mode": "single",
    "workers": 1
  },
  "resources_per_worker": {
    "cpu_cores": 1,
    "memory_gb": 1,
    "gpus": 0
  },
  "environment": {
    "requirements": "requirements.txt"
  },
  "recovery": {
    "mode": "checkpoint",
    "interval_seconds": 1,
    "max_retries": 2
  }
}
