{
  "schema_version": 1,
  "name": "distributed-classifier",
  "project": "ddp_project",
  "entrypoint": ["python", "train.py", "--epochs", "40", "--batch-delay", "0.2"],
  "dataset": "binary-classification.csv",
  "execution": {"mode": "distributed", "workers": 2},
  "resources_per_worker": {"cpu_cores": 1, "memory_gb": 1, "gpus": 0},
  "environment": {"requirements": "requirements.txt"},
  "recovery": {"mode": "restart", "max_retries": 2}
}
